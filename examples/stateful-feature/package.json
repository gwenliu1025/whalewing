{
  "name": "dsh-whalewing-saved-text",
  "version": "0.0.0",
  "private": true,
  "description": "保存文本：独立数据域、版本冲突与显式清除示例",
  "license": "Apache-2.0",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "host.js",
    "identity.js",
    "client.js",
    "src",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "contract.js",
    "store.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "whalewingExtension": {
    "id": "saved-text"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2"
  },
  "engines": {
    "dsh": "0.2.1-rc.2",
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "dsh-whalewing"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "zod": "4.4.3"
  }
}
